{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "red-door",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["17 5 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "red-door",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "STATIC", "bucket_name": "red-door-assets" }]
}
