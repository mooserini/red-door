{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "red-door",
  "account_id": "815bcdaf788850798df37ed8f3afb8d0",
  "main": "src/production.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "getadongle.com/*", "zone_id": "4e2ee5bb4dee2ff2ddcced14e2e0d5e9" }
  ],
  "triggers": { "crons": ["17 5 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "red-door",
    "database_id": "9be6882b-1919-4c79-a96a-0143e635a06e",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "STATIC", "bucket_name": "red-door-assets" }]
}
